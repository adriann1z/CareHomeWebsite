# Copy this file to .env (or .env.local) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code — see
# https://vite.dev/guide/env-and-mode.html. Never commit a real .env file.

# Production site URL (no trailing slash). Used to build canonical URLs,
# Open Graph tags, JSON-LD, and to generate sitemap.xml/robots.txt.
# Leave unset on staging/local — a clearly-fake placeholder domain is used
# instead so a missing value can never silently point at the wrong site.
VITE_SITE_URL=https://www.themeadowsscartho.example

# Google Analytics 4 Measurement ID. Optional — if unset, analytics stays
# fully disabled and the site still works normally.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: URL the enquiry form POSTs to (e.g. a Formspree/Netlify Forms/
# custom function endpoint that accepts multipart form data and returns a
# 2xx response on success). If unset, the enquiry form falls back to
# opening the visitor's email client with a pre-filled message instead of
# claiming a submission it can't actually confirm.
VITE_ENQUIRY_FORM_ENDPOINT=

# Set to "false" on staging/preview deployments to keep them out of search
# engines (adds a global Disallow to robots.txt). Defaults to allowed.
VITE_ALLOW_INDEXING=true

# --- Pre-existing AI Studio scaffold variables --------------------------
# Not used anywhere in src/ for this care-home site; kept only because they
# were part of the original project template. Safe to remove.
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
